---
import Layout from '../../../components/Layout.astro';
import { ROLE_SESSIONS, banksForRole, liveQuestions } from '../../../data/quizzes';

const sessions = Object.entries(ROLE_SESSIONS).map(([role, name]) => {
  const banks = banksForRole(role);
  const count = banks.reduce((n, t) => n + liveQuestions(t).length, 0);
  return { role, name, banks: banks.length, count };
});
---
<Layout
  title="Mixed practice sessions by role"
  description="Cross-topic practice sessions that pull questions from every quiz bank tagged for a role — AI engineer, ML engineer, designer, product manager and forward-deployed engineer."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Practice', url: '/practice' }, { name: 'Mixed sessions', url: '/practice/mixed' }]}
  itemList={sessions.map((s) => ({ name: `${s.name} practice session`, url: `/practice/mixed/${s.role}` }))}
>
  <section class="practice-hero container">
    <a class="back mono" href="/practice">← Practice room</a>
    <span class="eyebrow">Mixed sessions</span>
    <h1>Practice the way the job mixes topics.</h1>
    <p>Each session draws from every bank tagged for a role, so retrieval practice crosses topic boundaries the way real work does. Shuffle for a fresh order, cap the round with <code>?take=</code>, or let the spaced queue surface what's due.</p>
  </section>
  <section class="practice-grid container" aria-label="Role sessions">
    {sessions.map((s, index) => (
      <a class="practice-card" href={`/practice/mixed/${s.role}`}>
        <span class="mono index">{String(index + 1).padStart(2, '0')}</span>
        <h2>{s.name}</h2>
        <p>{s.count} questions across {s.banks} topic banks.</p>
        <span class="mono start">Start session →</span>
      </a>
    ))}
  </section>
</Layout>

<style>
  .practice-hero { padding-block: 58px 44px; max-width: 760px; }
  .back { display: block; color: var(--muted); font-size: 11px; margin-bottom: 26px; }
  .back:hover { color: var(--accent); text-decoration: none; }
  .practice-hero h1 { font-size: clamp(34px, 5vw, 52px); margin-top: 14px; }
  .practice-hero p { margin-top: 18px; color: var(--muted); font-size: 16px; line-height: 1.7; max-width: 62ch; }
  .practice-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  .practice-card { min-height: 216px; padding: 26px; background: var(--bg); display: flex; flex-direction: column; }
  .practice-card:hover { background: var(--paper); text-decoration: none; }
  .index { color: var(--faint); font-size: 11px; }
  .practice-card h2 { margin-top: 28px; font-size: 23px; }
  .practice-card p { margin-top: 10px; color: var(--muted); line-height: 1.55; }
  .start { margin-top: auto; padding-top: 22px; color: var(--accent); font-size: 11px; }
  @media (max-width: 820px) { .practice-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .practice-grid { grid-template-columns: 1fr; } }
</style>
