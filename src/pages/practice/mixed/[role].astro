---
import Layout from '../../../components/Layout.astro';
import Quiz from '../../../components/Quiz.astro';
import { ROLE_SESSIONS, banksForRole, liveQuestions } from '../../../data/quizzes';

export function getStaticPaths() {
  return Object.keys(ROLE_SESSIONS).map((role) => ({ params: { role } }));
}

const role = Astro.params.role!;
const name = ROLE_SESSIONS[role];
if (!name) throw new Error('Unknown role session');

const banks = banksForRole(role);
const questions = banks.flatMap((t) => liveQuestions(t));
---
<Layout title={`${name} mixed practice`} description={`A cross-topic practice session for ${name.toLowerCase()}s — ${questions.length} questions drawn from ${banks.length} quiz banks, every answer explained.`} type="learning-resource" breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Practice', url: '/practice' }, { name: 'Mixed sessions', url: '/practice/mixed' }, { name, url: `/practice/mixed/${role}` }]}>
  <section class="quiz-head container">
    <a class="back mono" href="/practice/mixed">← Mixed sessions</a>
    <span class="eyebrow">{questions.length} questions · {banks.length} banks · instant explanations</span>
    <h1>{name} session</h1>
    <p>Questions pulled from {banks.map((b) => b.name).join(', ')}. Shuffle for a fresh draw, cap the round with <code>?take=20</code>, or use the spaced queue to revisit what a week has faded.</p>
  </section>
  <section class="quiz-wrap container"><Quiz questions={questions} trackId={`mixed-${role}`} /></section>
</Layout>

<style>
  .quiz-head { padding-block: 48px 8px; max-width: 800px; }
  .back { display: block; color: var(--muted); font-size: 11px; margin-bottom: 30px; }
  .back:hover { color: var(--accent); text-decoration: none; }
  .quiz-head h1 { font-size: clamp(34px, 5vw, 48px); margin-top: 13px; }
  .quiz-head p { margin-top: 15px; color: var(--muted); font-size: 16px; line-height: 1.65; max-width: 62ch; }
  .quiz-wrap { max-width: 800px; padding-bottom: 12px; }
</style>
