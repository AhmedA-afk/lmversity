---
import Layout from '../../components/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('answers');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const all = await getCollection('answers');
const titleFor = new Map(all.map((a) => [`/answers/${a.id}`, a.data.title]));
const siblings = all.filter((a) => a.id !== entry.id && a.data.intent === entry.data.intent).slice(0, 5);
const kindLabel: Record<string, string> = { pillar: 'The path', howto: 'How to', definition: 'What it is', comparison: 'Compared' };
---
<Layout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  modifiedTime={entry.data.updated}
  publishedTime={entry.data.updated}
  faq={entry.data.faq}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Answers', url: '/answers' }, { name: entry.data.title, url: `/answers/${entry.id}` }]}
>
  <div class="wrap container">
    <article class="doc">
      <nav class="crumb mono" aria-label="Breadcrumb"><a href="/answers">Answers</a> <span>/</span> {kindLabel[entry.data.intent]}</nav>
      <h1>{entry.data.title}</h1>
      <p class="meta mono">Updated {entry.data.updated} · free, no account</p>
      <div class="prose"><Content /></div>

      {entry.data.faq.length > 0 && (
        <section class="faq">
          <h2>Frequently asked</h2>
          {entry.data.faq.map((f) => (
            <details><summary>{f.q}</summary><p>{f.a}</p></details>
          ))}
        </section>
      )}

      {entry.data.related.length > 0 && (
        <section class="related">
          <div class="eyebrow">Learn it properly</div>
          <ul>{entry.data.related.map((u) => <li><a href={u}>{titleFor.get(u) ?? u.replace(/^\/learn\//, '').replace(/-/g, ' ').replace(/\//g, ' · ')}</a></li>)}</ul>
        </section>
      )}
    </article>
    <aside class="toc" aria-label="On this page">
      <div class="toc-inner">
        {toc.length > 0 && (<><div class="eyebrow">On this page</div><ul>{toc.map((h) => (<li><a href={`#${h.slug}`}>{h.text}</a></li>))}</ul></>)}
        {siblings.length > 0 && (<><div class="eyebrow more">More answers</div><ul>{siblings.map((a) => (<li><a href={`/answers/${a.id}`}>{a.data.title}</a></li>))}</ul></>)}
      </div>
    </aside>
  </div>
</Layout>

<style>
  .wrap { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 48px; padding-block: 40px 72px; align-items: start; }
  .doc { min-width: 0; max-width: 740px; }
  .crumb { font-size: 11.5px; color: var(--muted); margin-bottom: 18px; }
  .crumb a { color: var(--muted); }
  .crumb a:hover { color: var(--accent); text-decoration: none; }
  .crumb span { margin: 0 6px; }
  .doc h1 { font-size: clamp(30px, 4.6vw, 42px); letter-spacing: -.022em; line-height: 1.12; }
  .meta { margin-top: 14px; font-size: 11px; color: var(--faint); letter-spacing: .04em; }
  .prose { margin-top: 26px; }
  .prose :global(> p:first-child) { font-size: 18px; line-height: 1.6; color: var(--text); padding: 16px 18px; border-left: 3px solid var(--accent); background: var(--paper); border-radius: 0 10px 10px 0; }
  .faq { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--rule); }
  .faq h2 { font-size: 22px; letter-spacing: -.012em; margin-bottom: 8px; }
  .faq details { border-bottom: 1px solid var(--rule); padding: 12px 0; }
  .faq summary { cursor: pointer; font: 500 15px/1.4 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; }
  .faq p { margin-top: 8px; font-size: 14.5px; line-height: 1.6; color: var(--muted); }
  .related { margin-top: 36px; }
  .related ul { margin: 10px 0 0; padding-left: 18px; font-size: 14.5px; line-height: 1.8; }
  .toc-inner { position: sticky; top: 84px; }
  .toc ul { list-style: none; padding: 0; margin: 10px 0 16px; display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; }
  .toc a { color: var(--muted); }
  .toc a:hover { color: var(--accent); text-decoration: none; }
  .toc .more { margin-top: 10px; }
  @media (max-width: 900px) { .wrap { grid-template-columns: 1fr; } .toc { display: none; } }
</style>
