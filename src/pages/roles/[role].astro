---
import Layout from '../../components/Layout.astro';
import { roles, getRole, conceptTitles } from '../../data/roles.ts';
import { getTrack } from '../../data/curriculum.ts';
import { roleArtAlt } from '../../data/role-art';
import { existsSync } from 'node:fs';

export function getStaticPaths() {
  // Designer has a dedicated course hub at /roles/designer. Keep all other
  // role pages on this compact path template.
  return roles.filter((r) => r.id !== 'designer').map((r) => ({ params: { role: r.id } }));
}

const { role: roleId } = Astro.params;
const role = getRole(roleId!)!;

// The illustration is decorative — the page states everything it conveys — but
// it still carries real alt text rather than an empty string, because the shape
// it describes is the one visual idea a screen-reader user would otherwise miss.
//
// Guard on the file, not on the alt text: the manifest describes every role,
// but generation is rate-limited and can leave gaps. A role without art renders
// without the image rather than shipping a broken one.
const artAlt = roleArtAlt[role.id];
const hasArt = existsSync(new URL(`../../../public/img/roles/role-${role.id}.webp`, import.meta.url));

const resolveRef = (ref: string) => {
  const [tid, slug] = ref.split('/');
  const track = getTrack(tid);
  const node = track?.nodes.find((n) => n.slug === slug);
  return {
    href: `/learn/${tid}/${slug}`,
    trackName: track?.name ?? tid,
    title: conceptTitles[ref] ?? node?.title ?? slug,
    hasPage: !!node && node.status === 'live',
  };
};

const steps = role.path.map(resolveRef);
const projects = (role.projects ?? []).map((p) => ({ ...p, ...resolveRef(p.ref) }));
const branches = (role.branches ?? []).map((b) => ({
  ...b,
  links: b.refs.map((tid) => ({ href: `/learn/${tid}`, name: getTrack(tid)?.name ?? tid })),
}));
---
<Layout
  title={`Free AI learning path for ${role.name}s`}
  description={`${role.description} Free to use, with no account required.`}
  type="collection"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Roles', url: '/roles' }, { name: `AI for ${role.name}s`, url: `/roles/${role.id}` }]}
  itemList={steps.filter((s) => s.hasPage).map((s) => ({ name: s.title, url: s.href }))}
>
  <section class="head container">
    <a href="/roles" class="back mono">← Roles</a>
    <div class="row"><span class="node-dot" aria-hidden="true"></span><span class="eyebrow">Role path</span></div>
    <div class="head-grid">
      <div>
        <h1>AI for {role.name}s</h1>
        <p class="desc">{role.description}</p>
        {role.prereq && <p class="prereq"><span class="mono">Before you start:</span> {role.prereq}</p>}
        <p class="meta mono">{steps.length} lessons, in order</p>
      </div>
      {hasArt && artAlt && (
        <img
          class="art"
          src={`/img/roles/role-${role.id}.webp`}
          alt={artAlt}
          width="1024"
          height="1024"
          loading="eager"
          decoding="async"
        />
      )}
    </div>
  </section>

  <section class="container path">
    <ol>
      {steps.map((s, i) => (
        <li class="step">
          <span class="sn mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="body">
            {s.hasPage ? <a href={s.href} class="title">{s.title}</a> : <span class="title dim">{s.title}</span>}
            <span class="track mono">{s.trackName}</span>
          </span>
          <span class="right mono">{s.hasPage ? 'Start →' : 'Coming'}</span>
        </li>
      ))}
    </ol>
    <p class="foot">Want the whole picture? <a href="/learn">Open the full map →</a></p>
  </section>

  {branches.length > 0 && (
    <section class="container extra">
      <h2>Optional branches</h2>
      <p class="sub">Once the core path holds, these tracks take you deeper in the direction you pick.</p>
      <ul class="cards">
        {branches.map((b) => (
          <li class="card">
            <span class="card-title">{b.label}</span>
            <span class="card-links">{b.links.map((l, i) => (<>{i > 0 && ' · '}<a href={l.href}>{l.name}</a></>))}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {projects.length > 0 && (
    <section class="container extra">
      <h2>Projects that prove it</h2>
      <p class="sub">The path ends in evidence — build these and you can show the skill, not claim it.</p>
      <ul class="cards">
        {projects.map((p) => (
          <li class="card">
            {p.hasPage ? <a href={p.href} class="card-title">{p.title}</a> : <span class="card-title">{p.title}</span>}
            <span class="card-note">{p.note}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {((role.interview?.length ?? 0) > 0 || (role.practice?.length ?? 0) > 0) && (
    <section class="container extra">
      <h2>Practice and interview prep</h2>
      <ul class="links">
        {(role.practice ?? []).map((t) => <li><a href={`/practice/${t}`}>Practice bank: {t.replace(/-/g, ' ')}</a></li>)}
        {(role.interview ?? []).map((t) => <li><a href={`/interview/${t}`}>Interview prep: {t.replace(/-/g, ' ')}</a></li>)}
      </ul>
    </section>
  )}

  {role.evidence && role.evidence.length > 0 && (
    <section class="container extra">
      <h2>Portfolio evidence to aim for</h2>
      <ul class="ticks">
        {role.evidence.map((e) => <li>{e}</li>)}
      </ul>
    </section>
  )}

  {role.credentials && role.credentials.length > 0 && (
    <section class="container extra">
      <h2>External credentials worth evaluating</h2>
      <p class="sub">Optional — listed for comparison, not endorsed. No credential guarantees a role, and none of these are required by this path.</p>
      <ul class="cards">
        {role.credentials.map((c) => (
          <li class="card">
            <span class="card-title">{c.name}</span>
            <span class="card-note">{c.org} — {c.note}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>

<style>
  .head { padding-block: 48px 8px; }
  .head-grid { display: grid; grid-template-columns: minmax(0, 1fr) 208px; gap: 48px; align-items: start; }
  /* The illustration is a light-ground raster and cannot follow the theme, so
     on dark it is inevitably a bright panel. A hairline makes that read as a
     deliberate inset plate rather than as an untreated white box. */
  .art {
    width: 208px; height: 208px; border-radius: 10px; justify-self: end;
    border: 1px solid var(--rule);
  }
  @media (max-width: 760px) {
    .head-grid { grid-template-columns: 1fr; gap: 26px; }
    .art { width: 132px; height: 132px; justify-self: start; order: -1; }
  }
  .back { font-size: 12px; color: var(--muted); }
  .back:hover { color: var(--accent); text-decoration: none; }
  .row { display: flex; align-items: center; gap: 10px; margin: 20px 0 10px; }
  .head h1 { font-size: clamp(30px, 4.5vw, 42px); letter-spacing: -.02em; }
  .desc { margin-top: 16px; font-size: 16px; line-height: 1.6; color: var(--muted); max-width: 60ch; }
  .meta { margin-top: 14px; font-size: 11px; color: var(--faint); letter-spacing: .04em; }

  .path { padding-top: 32px; }
  .path ol { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
  .step { display: flex; align-items: center; gap: 16px; padding: 15px 4px; border-bottom: 1px solid var(--rule); }
  .sn { flex: none; width: 24px; font-size: 11px; color: var(--faint); }
  .body { flex: 1; display: flex; flex-direction: column; gap: 3px; }
  .title { font: 500 15px/1.35 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; color: var(--text); }
  a.title:hover { color: var(--accent); text-decoration: none; }
  .title.dim { color: var(--muted); font-weight: 400; }
  .track { font-size: 10.5px; color: var(--faint); letter-spacing: .03em; }
  .right { flex: none; font-size: 11px; color: var(--faint); }
  .foot { margin-top: 28px; font-size: 14px; color: var(--muted); }

  .prereq { margin-top: 14px; font-size: 13.5px; line-height: 1.55; color: var(--muted); max-width: 62ch; padding: 10px 14px; border-left: 2px solid var(--accent); background: var(--panel); }
  .prereq .mono { font-size: 10.5px; color: var(--faint); letter-spacing: .04em; }
  .extra { padding-block: 34px 0; }
  .extra h2 { font-size: 20px; letter-spacing: -.01em; }
  .extra .sub { margin-top: 8px; font-size: 13.5px; color: var(--muted); max-width: 64ch; }
  .cards { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 10px; }
  .card { display: flex; flex-direction: column; gap: 4px; padding: 13px 16px; border: 1px solid var(--rule); border-radius: 8px; }
  .card-title { font: 500 14px/1.4 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; color: var(--text); }
  a.card-title:hover { color: var(--accent); text-decoration: none; }
  .card-links { font-size: 12.5px; color: var(--muted); }
  .card-note { font-size: 12.5px; color: var(--muted); line-height: 1.5; }
  .links { margin: 14px 0 0; padding-left: 18px; font-size: 14px; line-height: 2; }
  .ticks { margin: 14px 0 0; padding-left: 18px; font-size: 14px; line-height: 1.7; color: var(--text); }
  .ticks li { margin-bottom: 8px; }
</style>
