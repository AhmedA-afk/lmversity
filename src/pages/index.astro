---
import Layout from '../components/Layout.astro';
import { getCollection } from 'astro:content';
import { tracks, roleTracks } from '../data/curriculum.ts';
import { quizTracks } from '../data/quizzes';
import HeroScene from '../components/HeroScene.astro';

const lessons = await getCollection('lessons');
const guides = (await getCollection('guides')).sort(
  (a, b) => Date.parse(b.data.published) - Date.parse(a.data.published),
);
const posts = (await getCollection('blog')).sort(
  (a, b) => Date.parse(b.data.published) - Date.parse(a.data.published),
);
const questions = await getCollection('questions');
const scenarios = await getCollection('scenarios');

const quizCount = quizTracks.reduce((n, t) => n + t.questions.length, 0);
const featuredGuides = guides.filter((g) => g.data.featured).slice(0, 3);
const guideList = featuredGuides.length ? featuredGuides : guides.slice(0, 3);

const starts = [
  { tag: '01', name: 'Learn the ideas', href: '/learn', copy: `${lessons.length} lessons in dependency order, from "what is a token" to running agents in production.` },
  { tag: '02', name: 'Follow a guide', href: '/guides', copy: 'Task-shaped walkthroughs that take one real job end to end, with code you can run.' },
  { tag: '03', name: 'Prove it stuck', href: '/practice', copy: `${quizCount} questions with per-answer explanations, plus scenario walkthroughs and interview prep.` },
];

const values = [
  { h: 'Free and complete', p: 'The whole curriculum is open. No locked lessons, no “upgrade to continue”, no account needed to read a single page.' },
  { h: 'A path, not a pile', p: 'Tracks are sequenced by dependency and cross-linked. You always know what a page assumes and what it unlocks.' },
  { h: 'Honest about limits', p: 'Every technique gets its failure modes, not just its happy path. Where the evidence is thin, the page says so.' },
];

const stats = [
  [String(lessons.length), 'lessons'],
  [String(tracks.length), 'technical tracks'],
  [String(roleTracks.length), 'role paths'],
  [String(quizCount), 'quiz questions'],
  [String(questions.length), 'interview topics'],
  [String(scenarios.length), 'scenario walkthroughs'],
];
---
<Layout
  description={`Learn to actually build with AI. ${lessons.length} free, hands-on lessons across ${tracks.length} tracks — prompting, RAG, agents, MCP, evals and production — plus guides, quizzes and interview prep. No paywall.`}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow" data-hero-line>Free · hands-on · built for the agentic era<span class="ast" aria-hidden="true">*</span></span>
        <h1>
          <span class="line" data-hero-line>Learn to actually</span>
          <span class="line" data-hero-line>build with&nbsp;AI.</span>
        </h1>
        <p class="sub" data-hero-line>
          A structured path from your first prompt to production agents — with runnable code, worked
          examples and the decisions explained as you go. No paywall, no fluff.
        </p>
        <p class="footnote" data-hero-line><span class="ast" aria-hidden="true">*</span> Including the failure modes nobody puts in the tutorial. That is what the asterisk in the logo means.</p>
        <div class="cta" data-hero-line>
          <a href="/learn" class="btn btn-primary">Browse the curriculum</a>
          <button type="button" class="btn btn-ghost" data-search-open>Search {lessons.length} lessons ⌘K</button>
        </div>
        <div class="resume" data-resume hidden>
          <span class="eyebrow">Pick up where you left off</span>
          <a href="/learn"><span data-resume-title>Continue</span> <span class="rtrack mono" data-resume-track></span> →</a>
        </div>
      </div>
      <div class="hero-visual">
        <HeroScene />
      </div>
    </div>
    <div class="container">
      <aside class="hero-stats" aria-label="What's inside" data-reveal>
        {stats.map(([n, label]) => (
          <div class="stat" data-reveal-item>
            <strong data-count={n}>{n}</strong>
            <span>{label}</span>
          </div>
        ))}
      </aside>
    </div>
  </section>

  <section class="container starts" aria-label="Three ways to start" data-reveal>
    {starts.map((s) => (
      <a class="start" href={s.href} data-reveal-item>
        <span class="num mono">{s.tag}</span>
        <h2>{s.name}</h2>
        <p>{s.copy}</p>
      </a>
    ))}
  </section>

  <section class="container band">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Guides</span>
        <h2>Start with the job you're trying to do.</h2>
        <p>One page, one task, from empty editor to working result — with the decisions explained as you go.</p>
      </div>
      <a href="/guides" class="more-link">All guides →</a>
    </div>
    <div class="cards cards-3" data-reveal>
      {guideList.map((g) => (
        <a class="card" href={`/guides/${g.id}`} data-reveal-item>
          <span class="eyebrow">{g.data.level}</span>
          <h3>{g.data.title}</h3>
          <p>{g.data.description}</p>
          <span class="card-foot">{g.data.duration}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container band">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Why this exists</span>
        <h2>Most AI courses teach the demo. The demo is the easy part.</h2>
      </div>
    </div>
    <div class="cards cards-3" data-reveal>
      {values.map((v) => (
        <div class="card" data-reveal-item>
          <h3>{v.h}</h3>
          <p>{v.p}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container band">
    <div class="sec-head">
      <div>
        <span class="eyebrow">From the blog</span>
        <h2>Notes on building this stuff.</h2>
      </div>
      <a href="/blog" class="more-link">All posts →</a>
    </div>
    <div class="cards cards-3" data-reveal>
      {posts.slice(0, 3).map((p) => (
        <a class="card" href={`/blog/${p.id}`} data-reveal-item>
          <span class="eyebrow">{p.data.tags[0] ?? 'Notes'}</span>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
          <span class="card-foot">{p.data.published}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="closing container" data-reveal>
    <h2>Pick a track and start building.</h2>
    <p>Everything's free, nothing's gated, and you can start in the middle if you already know the start.</p>
    <div class="cta">
      <a href="/learn" class="btn btn-primary">Browse the curriculum</a>
      <a href="/roles" class="btn btn-ghost">Start from my role</a>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block: 56px 0; border-bottom: 1px solid var(--rule); overflow: hidden; }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 40px; align-items: center; padding-bottom: 40px; }
  .hero h1 { font-size: clamp(40px, 6.2vw, 68px); font-weight: 700; letter-spacing: -.026em; line-height: 1.02; margin-top: 18px; }
  .hero h1 .line { display: block; }
  .hero .eyebrow { display: inline-flex; align-items: baseline; gap: 2px; }
  .ast { color: var(--brand-warm); font-weight: 700; }
  .sub { margin-top: 22px; color: var(--muted); font-size: 17px; line-height: 1.65; max-width: 52ch; }
  .footnote { margin-top: 14px; font-size: 12.5px; line-height: 1.55; color: var(--faint); max-width: 52ch; }
  .footnote .ast { font-size: 13px; }
  .cta { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }

  /* Reveal targets start hidden only once the motion script has taken over,
     so the page never depends on JavaScript to show its content. */
  :global(html.js-motion) [data-hero-line], :global(html.js-motion) [data-reveal-item], :global(html.js-motion) .closing[data-reveal] { opacity: 0; }

  .resume { margin-top: 26px; padding: 14px 16px; border: 1px solid var(--rule); border-left: 3px solid var(--accent); border-radius: 8px; background: var(--paper); max-width: 480px; }
  .resume a { display: block; margin-top: 6px; font: 500 14.5px/1.4 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; }
  .rtrack { font-size: 11px; color: var(--muted); }

  .hero-visual { min-width: 0; }

  .hero-stats { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-bottom: 0; border-radius: 10px 10px 0 0; overflow: hidden; }
  .stat { background: var(--bg); padding: 18px 20px; }
  .stat strong { display: block; font: 600 26px/1 'Source Serif 4', 'Source Serif 4 Fallback', Georgia, serif; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .stat span { display: block; margin-top: 6px; font: 400 11.5px/1.3 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; color: var(--muted); }

  .starts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--rule); border-bottom: 1px solid var(--rule); }
  .start { background: var(--bg); padding: 32px 30px 30px; display: flex; flex-direction: column; }
  .start:hover { background: var(--paper); text-decoration: none; }
  .num { font-size: 11px; color: var(--muted); }
  .start h2 { margin-top: 14px; font-size: 21px; letter-spacing: -.014em; }
  .start:hover h2 { color: var(--accent); }
  .start p { margin-top: 9px; color: var(--muted); font-size: 13.5px; line-height: 1.6; }

  .band { padding-top: 66px; }
  .closing { padding-block: 76px 8px; text-align: center; }
  .closing h2 { font-size: clamp(26px, 4vw, 36px); letter-spacing: -.02em; }
  .closing p { margin-top: 14px; color: var(--muted); }
  .closing .cta { justify-content: center; }

  @media (max-width: 980px) {
    .hero-inner { grid-template-columns: 1fr; gap: 24px; }
    .hero-visual { max-width: 420px; }
    .hero-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .hero { padding-top: 40px; }
    .starts { grid-template-columns: 1fr; }
    .hero-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-visual { max-width: 300px; }
  }
</style>
