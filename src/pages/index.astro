---
import Layout from '../components/Layout.astro';
import HeroScene from '../components/HeroScene.astro';
import { getCollection } from 'astro:content';
import { tracks } from '../data/curriculum';
import { emblemGround, emblemAsterisk } from '../data/emblem';

const lessons = await getCollection('lessons');
const guides = await getCollection('guides');
const guideIds = ['build-a-rag-pipeline-over-your-own-documents', 'build-a-tool-calling-agent-from-scratch', 'build-an-mcp-server-in-python'];
const featured = guideIds.map(id => guides.find(g => g.id === id)).filter(Boolean);
const paths = [
  { name: 'Understand the foundations.', copy: 'Build a working mental model. What these systems do, how they learn, and where their limits begin.', links: [['AI Literacy', 'ai-literacy'], ['LLM Foundations', 'llm-foundations'], ['Maths Foundations', 'maths-foundations']] },
  { name: 'Make something that works.', copy: 'Move from an idea to a working system. Give models context, connect tools, and build the agent loop.', links: [['RAG', 'rag'], ['MCP', 'mcp'], ['Agentic AI', 'agentic-ai']] },
  { name: 'Make it work in the real world.', copy: 'Find the failure before your users do. Evaluate behavior, design guardrails, and operate with confidence.', links: [['Evals & Red-teaming', 'evals-red-teaming'], ['Production & Ops', 'production'], ['Harness Design', 'harness-design']] },
];
const entryPoints = [
  { title: 'I’m starting from zero.', subtitle: 'Start with AI Literacy', href: '/learn/ai-literacy' },
  { title: 'I already write code.', subtitle: 'Start with LLM Foundations', href: '/learn/llm-foundations' },
  { title: 'I have a role in mind.', subtitle: 'Explore the role paths', href: '/roles' },
];
---
<Layout landing description={`Learn to actually build with AI. ${lessons.length.toLocaleString('en-US')} free lessons across ${tracks.length} tracks, from your first prompt to production agents. No paywall, no account.`}>
  <div class="landing">
    <section class="opening shell" aria-labelledby="hero-title">
      <div class="opening-meta" data-hero-line>
        <span>An open education in AI.</span>
        <span>Independent. Free. Yours.</span>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">
            <span data-hero-line>Learn to</span>
            <span data-hero-line>actually build</span>
            <span class="final-line" data-hero-line>with AI.<svg viewBox="1100 498 97 97" aria-hidden="true"><path d={emblemAsterisk} /></svg></span>
          </h1>
          <p class="hero-description" data-hero-line>A structured path from your first prompt to production agents. The ideas, the code, and the decisions that make it work.</p>
          <div class="hero-actions" data-hero-line>
            <a href="/learn" class="action action-primary">Explore the curriculum <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a>
            <a href="#find-your-start" class="text-link">Find your starting point</a>
          </div>
          <p class="access-note" data-hero-line>No account. No paywall. Just a place to begin.</p>
        </div>
        <figure class="hero-art">
          <HeroScene />
          <figcaption><span>Structure for the curious.</span><span>Room to experiment.</span></figcaption>
        </figure>
      </div>
      <div class="opening-foot">
        <p><strong>{lessons.length.toLocaleString('en-US')} lessons.</strong> {tracks.length} technical tracks. One connected curriculum.</p>
        <a href="#curriculum" class="discover">Discover what’s inside<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15m-6-6 6 6 6-6" /></svg></a>
      </div>
      <div class="resume" data-resume hidden>
        <span>Continue learning</span>
        <a href="/learn"><span data-resume-title>Pick up where you left off</span> <span data-resume-track></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a>
      </div>
    </section>

    <section class="manifesto" aria-labelledby="manifesto-title">
      <div class="shell manifesto-inner">
        <div class="manifesto-symbol" aria-hidden="true"><svg viewBox="1100 498 97 97"><path d={emblemAsterisk} /></svg></div>
        <div>
          <h2 id="manifesto-title" data-reveal>The demo is<br />the easy part.</h2>
          <p class="manifesto-lead">Learn what happens after it works once.</p>
        </div>
        <div class="manifesto-copy" data-reveal>
          <p>When the answer sounds right but isn’t. When your retrieval misses the point. When an agent needs to stop.</p>
          <p>We teach the mechanism, the decisions, and the failure modes together. So you can build with understanding.</p>
          <a href="/about" class="text-link">The thinking behind LMVersity <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
          <small>The asterisk in our logo is a reminder: read the fine print.</small>
        </div>
      </div>
    </section>

    <section class="curriculum shell section-space" id="curriculum" aria-labelledby="curriculum-title">
      <div class="section-intro">
        <h2 id="curriculum-title" data-reveal>A path.<br /><span class="secondary">Not a pile.</span></h2>
        <div class="section-description">
          <p>Start with the foundations. Follow your curiosity. Every track connects the next idea to something you already understand.</p>
          <a href="/learn" class="text-link">Explore all {tracks.length} tracks <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a>
        </div>
      </div>
      <div class="path-list">
        {paths.map((path, i) => (
          <article class="path-row">
            <div class="path-visual" aria-hidden="true">
              <svg viewBox="0 0 100 100">
                {i === 0 ? <><path class="solid" d="M14 17h31v66H14zM55 17h31v66H55z" /><path class="cut" d="M14 47h72v6H14z" /></> : i === 1 ? <><path class="solid" d="M12 82V18l38 28 38-28v64Z" /><path class="cut" d="M47 43h6v39h-6z" /></> : <><path class="solid" d="M8 20h84L50 90Z" /><path class="warm" d="m72 9 5 6 8-3-1 8 7 4-7 5 1 8-8-3-5 6-4-7-8 1 2-8-6-5 8-3 1-8Z" /></>}
              </svg>
            </div>
            <div class="path-content"><h3>{path.name}</h3><p>{path.copy}</p></div>
            <div class="path-links">{path.links.map(([name, slug]) => <a href={`/learn/${slug}`}>{name}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>)}</div>
          </article>
        ))}
      </div>
    </section>

    <section class="start-section" id="find-your-start" aria-labelledby="start-title">
      <div class="shell start-inner">
        <div class="start-copy" data-reveal><h2 id="start-title">Your next chapter<br />starts here.</h2><p>You don’t need to know everything.<br />Just choose where you are today.</p></div>
        <div class="start-links">{entryPoints.map(entry => <a href={entry.href}><span><strong>{entry.title}</strong><span>{entry.subtitle}</span></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a>)}</div>
      </div>
    </section>

    <section class="guides shell section-space" aria-labelledby="guides-title">
      <div class="section-intro guide-intro"><h2 id="guides-title" data-reveal>Less watching.<br />More making.</h2><div class="section-description"><p>One real task. One working result. Practical guides with code you can run and the decisions explained as you go.</p><a href="/guides" class="text-link">All hands-on guides <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a></div></div>
      <div class="guide-list">{featured.map((guide, i) => guide && <a href={`/guides/${guide.id}`} class="guide-row"><span class="guide-kind">{['Retrieval', 'Agents', 'Tools'][i]}</span><h3>{guide.data.title}</h3><span class="guide-duration">{guide.data.duration}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>)}</div>
      <div class="practice-line"><p>And when you think you’ve got it, put it to the test.</p><div><a href="/practice">Practice quizzes</a><a href="/scenarios">Real-world scenarios</a><a href="/interview">Interview prep</a></div></div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="shell closing-inner">
        <div data-reveal><h2 id="closing-title">Build something<br />you understand.</h2><a href="/learn" class="action action-primary">Start learning <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a><p>Free. Open. Ready when you are.</p></div>
        <svg class="closing-mark" viewBox="350 330 820 820" aria-hidden="true"><path d={emblemGround} /></svg>
      </div>
    </section>
  </div>
</Layout>

<style>
  .landing { --section-space: clamp(80px, 9vw, 140px); overflow: clip; }
  .shell { width: min(100% - 112px, 1328px); margin-inline: auto; }
  .landing h1, .landing h2, .landing h3 { font-family: 'Source Serif 4', 'Source Serif 4 Fallback', Georgia, serif; font-weight: 400; letter-spacing: -.038em; text-wrap: balance; }
  .landing h2 { font-size: clamp(44px, 5.2vw, 72px); line-height: 1.04; }
  .landing p { text-wrap: pretty; }
  .landing a { text-underline-offset: 5px; }
  .landing svg { flex: none; }
  .landing a > svg, .resume a svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .landing a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  .opening { padding-top: 33px; }
  .opening-meta { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); letter-spacing: .015em; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 28px; min-height: 650px; padding-block: 40px 54px; }
  .hero-copy { position: relative; z-index: 2; }
  h1 { font-size: clamp(64px, 6.5vw, 96px); line-height: .98; }
  h1 > span { display: block; }
  h1 .final-line { display: flex; align-items: flex-start; gap: 14px; color: var(--brand-cool); }
  .final-line svg { width: .42em; height: .42em; margin-top: .05em; fill: var(--brand-warm); }
  .hero-description { font-size: 17px; line-height: 1.65; color: var(--muted); max-width: 420px; margin-top: 32px; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 32px; }
  .action { display: inline-flex; justify-content: space-between; align-items: center; gap: 24px; min-height: 52px; padding: 14px 22px; border: 1px solid transparent; border-radius: 4px; font-size: 14px; font-weight: 500; }
  .action-primary { color: var(--bg); background: var(--text); }
  .action-primary:hover { background: var(--brand-cool); color: var(--accent-contrast); text-decoration: none; }
  .text-link { display: inline-flex; align-items: center; gap: 16px; color: var(--text); font-size: 13px; border-bottom: 1px solid var(--rule); padding-block: 8px; }
  .text-link:hover { text-decoration: none; border-color: currentColor; }
  .access-note { font-size: 12px; margin-top: 19px; color: var(--muted); }
  .hero-art { position: relative; width: calc(100% + 64px); margin-left: -22px; height: 560px; }
  .hero-art figcaption { position: absolute; bottom: -3px; left: 10%; right: 10%; display: flex; justify-content: space-between; gap: 12px; font-size: 11px; color: var(--muted); }
  .opening-foot { border-block: 1px solid var(--rule); padding-block: 22px; display: flex; justify-content: space-between; align-items: center; gap: 24px; font-size: 13px; color: var(--muted); }
  .opening-foot strong { font-weight: 500; color: var(--text); }
  .discover { display: inline-flex; align-items: center; gap: 28px; color: var(--text); font-size: 12px; white-space: nowrap; }
  .resume { display: flex; align-items: baseline; gap: 24px; font-size: 12px; padding-block: 18px; color: var(--muted); }
  .resume[hidden] { display: none; }
  .resume > span { flex: none; }
  .resume a { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .resume [data-resume-track] { color: var(--muted); font-size: 11px; }
  .manifesto { background: var(--home-indigo); color: var(--home-paper); margin-top: 64px; }
  .manifesto-inner { display: grid; grid-template-columns: 56px 1.2fr 1fr; gap: 45px; padding-block: 96px; align-items: start; }
  .manifesto h2 { color: inherit; }
  .manifesto-symbol svg { width: 54px; fill: var(--home-brass); }
  .manifesto-lead { font-size: 16px; margin-top: 24px; color: var(--home-on-indigo); }
  .manifesto-copy { max-width: 360px; justify-self: end; }
  .manifesto-copy p { font-size: 16px; line-height: 1.8; color: var(--home-on-indigo); margin-bottom: 20px; }
  .manifesto .text-link { color: var(--home-paper); border-color: var(--home-rule-indigo); }
  .manifesto small { display: block; font-size: 11px; line-height: 1.6; margin-top: 24px; color: var(--home-on-indigo); }
  .section-space { padding-block: var(--section-space); }
  .section-intro { display: grid; grid-template-columns: 1.15fr 1fr; gap: 80px; margin-bottom: 64px; align-items: end; }
  .secondary { color: var(--muted); }
  .section-description { max-width: 400px; }
  .section-description p { color: var(--muted); font-size: 16px; line-height: 1.75; margin-bottom: 16px; }
  .path-row { display: grid; grid-template-columns: 125px 1.15fr 1fr; align-items: center; gap: 48px; padding-block: 36px; border-top: 1px solid var(--rule); }
  .path-row:last-child { border-bottom: 1px solid var(--rule); }
  .path-visual svg { width: 86px; height: 86px; }
  .solid { fill: var(--brand-cool); }
  .cut { fill: var(--bg); }
  .warm { fill: var(--brand-warm); }
  .path-content h3 { font-size: 29px; letter-spacing: -.025em; }
  .path-content p { max-width: 390px; font-size: 14px; color: var(--muted); margin-top: 12px; line-height: 1.7; }
  .path-links { display: flex; flex-direction: column; gap: 3px; padding-left: 34px; }
  .path-links a { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-block: 10px; color: var(--text); font-size: 14px; }
  .path-links svg { width: 15px !important; height: 15px !important; color: var(--muted); }
  .path-links a:hover { color: var(--accent); }
  .start-section { background: var(--paper); }
  .start-inner { display: grid; grid-template-columns: 1.15fr 1fr; gap: 80px; padding-block: 88px; align-items: center; }
  .start-copy h2 { font-size: clamp(40px, 4.1vw, 56px); }
  .start-copy p { margin-top: 24px; font-size: 15px; line-height: 1.8; color: var(--muted); }
  .start-links a { padding-block: 25px; display: flex; justify-content: space-between; align-items: center; gap: 24px; border-top: 1px solid var(--rule); color: var(--text); }
  .start-links a:last-child { border-bottom: 1px solid var(--rule); }
  .start-links a:hover { text-decoration: none; color: var(--accent); }
  .start-links strong { font-weight: 500; font-size: 20px; }
  .start-links span > span { display: block; color: var(--muted); font-size: 12px; margin-top: 7px; }
  .guide-row { display: grid; grid-template-columns: 130px 1fr 80px 24px; gap: 30px; align-items: center; border-top: 1px solid var(--rule); padding-block: 30px; color: var(--text); }
  .guide-row:last-child { border-bottom: 1px solid var(--rule); }
  .guide-row h3 { font-size: 27px; letter-spacing: -.022em; line-height: 1.3; max-width: 700px; }
  .guide-kind, .guide-duration { font-size: 12px; color: var(--muted); }
  .guide-row:hover { text-decoration: none; color: var(--accent); }
  .guide-row:hover h3 { color: var(--accent); }
  .practice-line { margin-top: 35px; display: flex; justify-content: space-between; gap: 24px; font-size: 13px; }
  .practice-line p { color: var(--muted); }
  .practice-line > div { display: flex; flex-wrap: wrap; gap: 24px; }
  .practice-line a { color: var(--text); text-decoration: underline; text-decoration-color: var(--rule); }
  .closing { border-top: 1px solid var(--rule); background: var(--paper); }
  .closing-inner { display: flex; align-items: center; justify-content: space-between; gap: 80px; padding-block: 90px; }
  .closing h2 { font-size: clamp(44px, 5.5vw, 76px); }
  .closing .action { margin-top: 34px; min-width: 185px; }
  .closing p { font-size: 12px; color: var(--muted); margin-top: 18px; }
  .closing-mark { width: min(30%, 350px); fill: none; stroke: var(--brand-cool); stroke-width: 1.4px; }
  @media (min-width: 1650px) { .hero-grid { min-height: 720px; } .hero-art { height: 620px; } }
  @media (max-width: 1100px) {
    .shell { width: calc(100% - 64px); }
    .hero-grid { min-height: 590px; gap: 0; }
    h1 { font-size: 68px; }
    .hero-art { height: 460px; width: calc(100% + 40px); }
    .hero-actions { gap: 14px; }
    .manifesto-inner { grid-template-columns: 35px 1fr 1fr; gap: 28px; }
    .manifesto-symbol svg { width: 35px; }
    .path-row { grid-template-columns: 85px 1.2fr 1fr; gap: 28px; }
    .path-links { padding-left: 0; }
    .section-intro, .start-inner { gap: 40px; }
  }
  @media (max-width: 760px) {
    .shell { width: calc(100% - 40px); }
    .opening { padding-top: 22px; }
    .opening-meta { font-size: 10px; }
    .hero-grid { grid-template-columns: 1fr; padding-block: 42px 26px; }
    h1 { font-size: clamp(56px, 11.5vw, 84px); }
    .hero-description { margin-top: 24px; font-size: 16px; max-width: 440px; }
    .hero-actions { margin-top: 26px; gap: 18px; }
    .hero-art { width: min(100%, 490px); height: 370px; margin: 0 auto; }
    .hero-art figcaption { bottom: 0; font-size: 10px; }
    .opening-foot { flex-direction: column; align-items: flex-start; gap: 12px; padding-block: 20px; font-size: 12px; }
    .discover { gap: 12px; }
    .resume { align-items: flex-start; gap: 10px; flex-direction: column; }
    .manifesto { margin-top: 36px; }
    .manifesto-inner { grid-template-columns: 1fr; gap: 24px; padding-block: 60px; }
    .manifesto-symbol svg { width: 38px; }
    .manifesto-copy { max-width: 100%; justify-self: start; }
    .manifesto-copy p { font-size: 15px; }
    .section-intro { grid-template-columns: 1fr; gap: 25px; margin-bottom: 40px; }
    .path-row { grid-template-columns: 54px 1fr; gap: 20px; padding-block: 28px; align-items: start; }
    .path-visual svg { width: 50px; height: 50px; }
    .path-content h3 { font-size: 25px; }
    .path-links { grid-column: 2; }
    .start-inner { grid-template-columns: 1fr; gap: 32px; padding-block: 64px; }
    .guide-row { grid-template-columns: 1fr 24px; gap: 14px; padding-block: 25px; }
    .guide-kind { grid-column: 1; }
    .guide-row h3 { grid-column: 1; grid-row: 2; font-size: 25px; }
    .guide-duration { grid-column: 1; grid-row: 3; }
    .guide-row > svg { grid-column: 2; grid-row: 2; }
    .practice-line { flex-direction: column; }
    .practice-line > div { gap: 18px; }
    .closing-inner { gap: 20px; padding-block: 64px; }
    .closing-mark { width: 20%; }
    .closing h2 { font-size: 42px; }
  }
  @media (max-width: 390px) {
    h1 { font-size: 52px; }
    .hero-art { height: 310px; }
    .closing-mark { display: none; }
    .hero-actions { align-items: flex-start; flex-direction: column; }
  }
</style>
