</div>

<script>
  import { startHomeMotion } from '../scripts/home-motion';
  startHomeMotion();

  const el = document.querySelector<HTMLElement>('[data-hero-scene]');
  const canvas = document.createElement('canvas');
  const webgl = !!(canvas.getContext('webgl2') || canvas.getContext('webgl'));
  const wants = el && webgl && matchMedia('(prefers-reduced-motion: no-preference)').matches && innerWidth > 720;
  if (wants) {
    const start = () => import('../scripts/hero-scene').then((m) => m.mountHero(el!)).catch(() => {});
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start, { timeout: 1500 });
    else setTimeout(start, 300);
  }
</script>

<style>
  .hero-scene { position: relative; width: 100%; aspect-ratio: 1 / 1; max-height: 520px; }
  .hero-scene :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; display: block; }
  .hero-scene :global(.hero-fallback) {
    position: absolute; left: 8%; right: 8%; top: 50%; transform: translateY(-50%);
    width: 84%; height: auto; color: var(--brand-cool);
    transition: opacity .5s ease;
  }
  .hero-scene :global(.hero-fallback .wm-letter) { fill: currentColor; }
  .hero-scene :global(.hero-fallback .wm-ast) { fill: var(--brand-warm); }
  .hero-scene.is-live :global(.hero-fallback) { opacity: 0; }
</style>
