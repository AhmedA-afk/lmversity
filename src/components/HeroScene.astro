---
import emblem from '../../public/brand/emblem-sculpture.svg?raw';
---
<div class="hero-scene" data-hero-scene aria-hidden="true">
  <div class="sculpture-fallback" set:html={emblem} />
</div>
<script>
  import { startHomeMotion } from '../scripts/home-motion';
  startHomeMotion();
  const el = document.querySelector<HTMLElement>('[data-hero-scene]');
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  let dispose: (() => void) | undefined;
  let mounted = false;
  let closed = false;
  const start = async () => {
    if (!el || mounted || closed || preference.matches) return;
    mounted = true;
    try {
      const { mountHero } = await import('../scripts/hero-scene');
      if (!preference.matches && !closed) {
        const teardown = await mountHero(el);
        // The SVG fetch can resolve after a preference change or navigation.
        if (preference.matches || closed || !el.isConnected) teardown();
        else dispose = teardown;
      }
    } catch { /* The original SVG remains fully visible if WebGL is unavailable. */ }
  };
  if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 1200 });
  else setTimeout(start, 150);
  preference.addEventListener('change', () => { if (preference.matches) { dispose?.(); dispose = undefined; } });
  window.addEventListener('pagehide', () => { closed = true; dispose?.(); }, { once: true });
</script>
<style>
  .hero-scene { position: relative; width: 100%; height: 100%; min-height: 320px; }
  .sculpture-fallback { position: absolute; inset: 0; display: grid; place-items: center; }
  .sculpture-fallback :global(svg) { width: 100%; height: 100%; overflow: visible; }
  .sculpture-fallback :global(.emblem-ground) { fill: var(--brand-cool); }
  .sculpture-fallback :global(.emblem-asterisk) { fill: var(--brand-warm); }
  .hero-scene :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-scene.is-live .sculpture-fallback { visibility: hidden; }
</style>
