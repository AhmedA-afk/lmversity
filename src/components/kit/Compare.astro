---
/**
 * Two panes side by side. Children are <Pane title="…" tone="good|bad|neutral">.
 * Typical pairs: before/after, naive/robust, prompt A/prompt B.
 */
interface Props { title?: string }
const { title } = Astro.props;
---
<div class="compare">
  {title && <div class="compare-title">{title}</div>}
  <div class="compare-grid"><slot /></div>
</div>

<style>
  .compare { margin: 1.6em 0; }
  .compare-title { font: 500 11px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .compare-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: 8px; overflow: hidden; }
  @media (max-width: 720px) { .compare-grid { grid-template-columns: 1fr; } }
</style>
