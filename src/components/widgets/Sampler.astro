---
/**
 * Temperature, top-k and top-p over one next-token distribution. The logits
 * are illustrative: chosen so that the mechanism is visible, not read from a
 * model. The note says so on the page.
 */
import Widget from './Widget.astro';
const candidates = [
  { t: ' Paris', l: 6.0 }, { t: ' the', l: 3.4 }, { t: ' a', l: 3.0 }, { t: ' located', l: 2.5 },
  { t: ' known', l: 1.9 }, { t: ' not', l: 1.5 }, { t: ' Lyon', l: 1.0 }, { t: ' France', l: 0.6 },
];
---
<Widget title="Sampling: temperature, top-k, top-p" note="Illustrative logits for the prompt shown, chosen to make the mechanism visible. They are not a real model's output. Temperature rescales the logits before softmax; top-k and top-p then cut the tail and the survivors are renormalised.">
  <div class="samp" data-sampler data-cands={JSON.stringify(candidates)}>
    <p class="samp-prompt mono">The capital of France is<span class="samp-cursor">▮</span></p>
    <div class="widget-controls">
      <label>Temperature <input type="range" data-temp min="0.1" max="2" step="0.05" value="1" /><b class="mono" data-temp-v>1.00</b></label>
      <label>Top-k <input type="range" data-topk min="1" max="8" step="1" value="8" /><b class="mono" data-topk-v>8</b></label>
      <label>Top-p <input type="range" data-topp min="0.05" max="1" step="0.05" value="1" /><b class="mono" data-topp-v>1.00</b></label>
    </div>
    <div class="samp-bars" data-bars role="img" aria-label="Probability of each candidate next token under the current settings"></div>
    <div class="widget-controls samp-actions">
      <button type="button" class="btn btn-ghost" data-sample>Sample 100 tokens</button>
      <button type="button" class="btn btn-ghost" data-reset>Reset</button>
      <span class="mono samp-drawn" data-drawn></span>
    </div>
  </div>
</Widget>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-sampler]')) {
    const cands: { t: string; l: number }[] = JSON.parse(root.dataset.cands || '[]');
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const temp = q<HTMLInputElement>('[data-temp]'), topk = q<HTMLInputElement>('[data-topk]'), topp = q<HTMLInputElement>('[data-topp]');
    const bars = q<HTMLElement>('[data-bars]'), drawn = q<HTMLElement>('[data-drawn]');
    let counts = new Array(cands.length).fill(0), total = 0;
    const compute = () => {
      const T = Number(temp.value), K = Number(topk.value), P = Number(topp.value);
      const scaled = cands.map((c) => c.l / T);
      const m = Math.max(...scaled);
      const ex = scaled.map((s) => Math.exp(s - m));
      const z = ex.reduce((a, b) => a + b, 0);
      const p = ex.map((e) => e / z);
      const order = p.map((v, i) => i).sort((a, b) => p[b] - p[a]);
      const keep = new Array(cands.length).fill(false);
      let cum = 0;
      order.forEach((i, rank) => {
        if (rank >= K) return;
        if (rank > 0 && cum >= P) return;
        keep[i] = true; cum += p[i];
      });
      const zk = p.reduce((a, v, i) => a + (keep[i] ? v : 0), 0);
      const final = p.map((v, i) => (keep[i] ? v / zk : 0));
      return { p, keep, final };
    };
    const render = () => {
      q<HTMLElement>('[data-temp-v]').textContent = Number(temp.value).toFixed(2);
      q<HTMLElement>('[data-topk-v]').textContent = topk.value;
      q<HTMLElement>('[data-topp-v]').textContent = Number(topp.value).toFixed(2);
      const { p, keep, final } = compute();
      bars.innerHTML = cands.map((c, i) => `
        <div class="samp-row ${keep[i] ? '' : 'is-cut'}">
          <span class="samp-tok mono">${c.t.replace(/^ /, '␣')}</span>
          <span class="samp-track"><span class="samp-raw" style="width:${(p[i] * 100).toFixed(1)}%"></span><span class="samp-fill" style="width:${(final[i] * 100).toFixed(1)}%"></span></span>
          <span class="samp-val mono">${keep[i] ? (final[i] * 100).toFixed(1) + '%' : 'cut'}</span>
          <span class="samp-count mono">${total ? counts[i] : ''}</span>
        </div>`).join('');
    };
    const sample = () => {
      const { final } = compute();
      for (let n = 0; n < 100; n++) {
        let r = Math.random(), i = 0;
        for (; i < final.length - 1; i++) { r -= final[i]; if (r <= 0) break; }
        counts[i]++; total++;
      }
      drawn.textContent = `${total} drawn`;
      render();
    };
    [temp, topk, topp].forEach((el) => el.addEventListener('input', () => { counts.fill(0); total = 0; drawn.textContent = ''; render(); }));
    q<HTMLButtonElement>('[data-sample]').addEventListener('click', sample);
    q<HTMLButtonElement>('[data-reset]').addEventListener('click', () => { temp.value = '1'; topk.value = '8'; topp.value = '1'; counts.fill(0); total = 0; drawn.textContent = ''; render(); });
    render();
  }
</script>

<style>
  .samp-prompt { margin: 0 0 12px; padding: 8px 12px; background: var(--paper); border: 1px solid var(--rule); border-radius: 6px; font-size: 13.5px; }
  .samp-cursor { color: var(--brand-cool); margin-left: 2px; animation: blink 1.1s steps(2) infinite; }
  @keyframes blink { to { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .samp-cursor { animation: none; } }
  .samp-bars { display: flex; flex-direction: column; gap: 6px; }
  .samp-bars :global(.samp-row) { display: grid; grid-template-columns: 84px 1fr 52px 34px; gap: 10px; align-items: center; font-size: 12.5px; }
  .samp-bars :global(.samp-tok) { color: var(--text); }
  .samp-bars :global(.samp-track) { position: relative; height: 14px; background: var(--paper); border: 1px solid var(--rule); border-radius: 3px; overflow: hidden; }
  .samp-bars :global(.samp-raw) { position: absolute; inset: 0 auto 0 0; background: var(--rule); }
  .samp-bars :global(.samp-fill) { position: absolute; inset: 0 auto 0 0; background: var(--brand-cool); transition: width .15s ease-out; }
  .samp-bars :global(.is-cut .samp-fill) { background: transparent; }
  .samp-bars :global(.is-cut .samp-tok), .samp-bars :global(.is-cut .samp-val) { color: var(--brand-warm); }
  .samp-bars :global(.samp-val) { text-align: right; color: var(--muted); }
  .samp-bars :global(.samp-count) { text-align: right; color: var(--muted); }
  .samp-actions { margin: 14px 0 0; }
  .samp-drawn { font-size: 12px; color: var(--muted); }
</style>
