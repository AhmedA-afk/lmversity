---
/**
 * Two parts. Vectors: drag two arrows and watch dot product, cosine and
 * distance move, with a normalise toggle. Words: cosine between bag-of-words
 * vectors of two sentences, which is what similarity looks like *without* an
 * embedding model, so the reader sees exactly what embeddings add.
 */
import Widget from './Widget.astro';
---
<Widget title="Similarity: what cosine actually measures" note="The vector panel is exact geometry. The sentence panel counts words only: it has no idea that two different words can mean the same thing. That gap is what an embedding model closes, and why 'lexical overlap' and 'semantic similarity' are different measurements.">
  <div class="sim" data-sim>
    <div class="sim-grid">
      <div>
        <div class="sim-sub">Vectors</div>
        <svg class="sim-svg" data-svg viewBox="0 0 260 260" role="img" aria-label="Two draggable vectors from a shared origin">
          <line x1="0" y1="130" x2="260" y2="130" class="sim-axis" /><line x1="130" y1="0" x2="130" y2="260" class="sim-axis" />
          <line data-a x1="130" y1="130" x2="230" y2="70" class="sim-vec sim-a" />
          <line data-b x1="130" y1="130" x2="180" y2="40" class="sim-vec sim-b" />
          <circle data-ha cx="230" cy="70" r="9" class="sim-handle sim-a" /><circle data-hb cx="180" cy="40" r="9" class="sim-handle sim-b" />
          <text x="236" y="66" class="sim-lbl sim-a">a</text><text x="186" y="36" class="sim-lbl sim-b">b</text>
        </svg>
        <div class="widget-controls"><label><input type="checkbox" data-norm /> normalise to unit length</label></div>
        <div class="widget-stats" data-vstats></div>
      </div>
      <div>
        <div class="sim-sub">Sentences (bag of words)</div>
        <input type="text" data-s1 value="The car would not start this morning." />
        <input type="text" data-s2 value="My automobile refused to start today." />
        <div class="sim-words" data-words></div>
        <div class="widget-stats" data-wstats></div>
      </div>
    </div>
  </div>
</Widget>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-sim]')) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const svg = q<SVGSVGElement>('[data-svg]'), norm = q<HTMLInputElement>('[data-norm]'), vstats = q<HTMLElement>('[data-vstats]');
    const O = 130, S = 40; // origin, px per unit
    const vec = { a: [2.5, 1.5], b: [1.25, 2.25] } as Record<'a' | 'b', number[]>;
    const draw = () => {
      const show = { a: [...vec.a], b: [...vec.b] };
      if (norm.checked) for (const k of ['a', 'b'] as const) { const n = Math.hypot(...show[k]) || 1; show[k] = show[k].map((v) => v / n * 2.2); }
      for (const k of ['a', 'b'] as const) {
        const x = O + show[k][0] * S, y = O - show[k][1] * S;
        const line = q<SVGLineElement>(`[data-${k}]`), h = q<SVGCircleElement>(`[data-h${k}]`);
        line.setAttribute('x2', String(x)); line.setAttribute('y2', String(y));
        h.setAttribute('cx', String(x)); h.setAttribute('cy', String(y));
        const t = svg.querySelector<SVGTextElement>(`.sim-lbl.sim-${k}`)!; t.setAttribute('x', String(x + 6)); t.setAttribute('y', String(y - 4));
      }
      const a = norm.checked ? vec.a.map((v) => v / (Math.hypot(...vec.a) || 1)) : vec.a;
      const b = norm.checked ? vec.b.map((v) => v / (Math.hypot(...vec.b) || 1)) : vec.b;
      const dot = a[0] * b[0] + a[1] * b[1], na = Math.hypot(...a), nb = Math.hypot(...b);
      const cos = na && nb ? dot / (na * nb) : 0;
      const dist = Math.hypot(a[0] - b[0], a[1] - b[1]);
      vstats.innerHTML = `<span>dot <b>${dot.toFixed(2)}</b></span><span>|a| <b>${na.toFixed(2)}</b></span><span>|b| <b>${nb.toFixed(2)}</b></span><span>cosine <b>${cos.toFixed(3)}</b></span><span>angle <b>${(Math.acos(Math.max(-1, Math.min(1, cos))) * 180 / Math.PI).toFixed(0)}°</b></span><span>euclidean <b>${dist.toFixed(2)}</b></span>`;
    };
    let dragging: 'a' | 'b' | null = null;
    const pt = (e: PointerEvent) => { const r = svg.getBoundingClientRect(); const x = (e.clientX - r.left) / r.width * 260, y = (e.clientY - r.top) / r.height * 260; return [(x - O) / S, (O - y) / S]; };
    for (const k of ['a', 'b'] as const) q<SVGCircleElement>(`[data-h${k}]`).addEventListener('pointerdown', (e) => { dragging = k; svg.setPointerCapture(e.pointerId); });
    svg.addEventListener('pointermove', (e) => { if (!dragging) return; vec[dragging] = pt(e).map((v) => Math.max(-3, Math.min(3, v))); if (norm.checked) norm.checked = false; draw(); });
    svg.addEventListener('pointerup', () => { dragging = null; });
    norm.addEventListener('change', draw);
    draw();

    const s1 = q<HTMLInputElement>('[data-s1]'), s2 = q<HTMLInputElement>('[data-s2]'), words = q<HTMLElement>('[data-words]'), wstats = q<HTMLElement>('[data-wstats]');
    const bag = (s: string) => { const m = new Map<string, number>(); for (const w of s.toLowerCase().match(/[a-z0-9']+/g) || []) m.set(w, (m.get(w) || 0) + 1); return m; };
    const wordsRender = () => {
      const A = bag(s1.value), B = bag(s2.value);
      const vocab = [...new Set([...A.keys(), ...B.keys()])];
      let dot = 0, na = 0, nb = 0;
      for (const w of vocab) { const x = A.get(w) || 0, y = B.get(w) || 0; dot += x * y; na += x * x; nb += y * y; }
      const cos = na && nb ? dot / Math.sqrt(na * nb) : 0;
      words.innerHTML = vocab.map((w) => `<span class="sim-w ${A.has(w) && B.has(w) ? 'is-shared' : ''}">${w}</span>`).join('');
      const shared = vocab.filter((w) => A.has(w) && B.has(w)).length;
      wstats.innerHTML = `<span>shared words <b>${shared}</b></span><span>vocabulary <b>${vocab.length}</b></span><span>lexical cosine <b>${cos.toFixed(3)}</b></span>`;
    };
    s1.addEventListener('input', wordsRender); s2.addEventListener('input', wordsRender); wordsRender();
  }
</script>

<style>
  .sim-grid { display: grid; grid-template-columns: 260px 1fr; gap: 22px; align-items: start; }
  @media (max-width: 720px) { .sim-grid { grid-template-columns: 1fr; } }
  .sim-sub { font: 500 11px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .sim-svg { width: 260px; max-width: 100%; height: auto; display: block; border: 1px solid var(--rule); border-radius: 6px; background: var(--paper); touch-action: none; }
  .sim-axis { stroke: var(--rule); stroke-width: 1; }
  .sim-vec { stroke-width: 2; }
  .sim-vec.sim-a, .sim-handle.sim-a { stroke: var(--brand-cool); }
  .sim-vec.sim-b, .sim-handle.sim-b { stroke: var(--brand-warm); }
  .sim-handle { fill: var(--bg); stroke-width: 2; cursor: grab; }
  .sim-lbl { font: 500 12px 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; }
  .sim-lbl.sim-a { fill: var(--brand-cool); } .sim-lbl.sim-b { fill: var(--brand-warm); }
  .sim input[type=text] { width: 100%; box-sizing: border-box; }
  .sim input[type=text] + input[type=text] { margin-top: 8px; }
  .sim-words { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .sim-words :global(.sim-w) { font: 400 12px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; padding: 5px 7px; border: 1px solid var(--rule); border-radius: 4px; color: var(--muted); }
  .sim-words :global(.sim-w.is-shared) { color: var(--brand-cool); border-color: var(--brand-cool); background: var(--accent-wash); }
</style>
