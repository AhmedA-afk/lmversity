---
/**
 * One ad unit, below the primary content. Renders nothing unless
 * site.ads.client is set, so a site without AdSense has no placeholder, no
 * reserved space and no script. Labelled, because readers deserve to know.
 */
import { site } from '../data/site';

interface Props {
  /** Which slot id to use from site.ads.slots. */
  kind: 'lesson' | 'guide' | 'blog';
}
const { kind } = Astro.props;
const client = site.ads.client;
const slot = client ? site.ads.slots[kind] : '';
---
{client && (
  <aside class="ad" aria-label="Advertisement">
    <span class="ad-label mono">Advertisement</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot || undefined}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}

<style>
  .ad { margin-top: 40px; padding-top: 14px; border-top: 1px solid var(--rule); }
  .ad-label { display: block; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); margin-bottom: 8px; }
  .ad :global(.adsbygoogle) { min-height: 90px; }
</style>
