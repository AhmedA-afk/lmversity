---
import Figure from './Figure.astro';

/**
 * The six-month trust gap. Figures are the ones OpenAI's head of FDE stated publicly; the prose cites them.
 */
---
<Figure
  title="Build time versus trust time"
  caption="In the Morgan Stanley deployment as its FDE lead describes it, the technical build took six to eight weeks and the pilots that earned adoption took about four more months. The brass span is where engagements stall."
  desc="A timeline with a short box labelled build, a much longer brass box labelled pilots, and a final box labelled adoption."
>
  <svg viewBox="0 0 660 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="10" y="50" width="120" height="42" rx="6" class="dg-box" /><text x="70" y="75" class="dg-label">BUILD</text>
    <rect x="140" y="50" width="380" height="42" rx="6" class="dg-box-warn" /><text x="330" y="75" class="dg-label dg-label-warn">PILOTS</text>
    <rect x="530" y="50" width="120" height="42" rx="6" class="dg-box" /><text x="590" y="75" class="dg-label">ADOPTION</text>
    <text x="70" y="118" class="dg-note">6 to 8 weeks</text>
    <text x="330" y="118" class="dg-note">about four months</text>
    <text x="590" y="118" class="dg-note">the outcome</text>
    <line x1="10" y1="30" x2="650" y2="30" class="dg-rule" />
    <text x="330" y="22" class="dg-note">time</text>
  </svg>
</Figure>
