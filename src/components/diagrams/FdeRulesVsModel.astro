---
import Figure from './Figure.astro';

/**
 * Deterministic versus probabilistic, from the supply-chain deployment described by OpenAI's head of FDE.
 */
---
<Figure
  title="Where the line between rules and the model goes"
  caption="Hard business constraints live in code and are enforced deterministically. The model proposes, ranks and explains. A person decides. The brass rule is the boundary; anything that crosses it the wrong way is a production incident."
  desc="Two boxes side by side, rules in code and model proposes, separated by a vertical dashed brass line. A third box beneath, human decides, receives lines from both."
>
  <svg viewBox="0 0 640 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs><marker id="rm-tip" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 z" class="dg-arrow" /></marker></defs>
    <rect x="40" y="40" width="220" height="70" rx="6" class="dg-box" />
    <text x="150" y="70" class="dg-label">RULES IN CODE</text>
    <text x="150" y="94" class="dg-note">limits, minimums, lead times</text>
    <rect x="380" y="40" width="220" height="70" rx="6" class="dg-box" />
    <text x="490" y="70" class="dg-label">MODEL PROPOSES</text>
    <text x="490" y="94" class="dg-note">options, ranking, reasoning</text>
    <line x1="320" y1="24" x2="320" y2="126" class="dg-line-warn" />
    <text x="320" y="144" class="dg-note dg-note-warn">the boundary</text>
    <rect x="210" y="170" width="220" height="42" rx="6" class="dg-box" />
    <text x="320" y="195" class="dg-label">HUMAN DECIDES</text>
    <line x1="150" y1="110" x2="270" y2="166" class="dg-line" marker-end="url(#rm-tip)" />
    <line x1="490" y1="110" x2="370" y2="166" class="dg-line" marker-end="url(#rm-tip)" />
  </svg>
</Figure>
