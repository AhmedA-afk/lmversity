---
import Figure from './Figure.astro';

/**
 * Three stakeholders, three positions, three separate conversations.
 */
---
<Figure
  title="The three conversations"
  caption="The business owner wants an outcome by a date, IT wants access and operations to stay safe, security wants the data and the risk bounded. They are three conversations with three positions; holding them as one meeting is how a deployment stalls."
  desc="A central box labelled FDE with three boxes around it: business owner, IT, security. Each is joined to the centre by a line and carries a short note. A dashed brass note beneath reads one meeting for all three."
>
  <svg viewBox="0 0 640 250" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="260" y="99" width="120" height="42" rx="6" class="dg-box" /><text x="320" y="124" class="dg-label">FDE</text>
    <rect x="20" y="99" width="150" height="42" rx="6" class="dg-box" /><text x="95" y="118" class="dg-label">BUSINESS</text><text x="95" y="131" class="dg-label">OWNER</text>
    <text x="95" y="165" class="dg-note">outcome, by a date</text>
    <rect x="470" y="20" width="150" height="42" rx="6" class="dg-box" /><text x="545" y="45" class="dg-label">IT</text>
    <text x="545" y="80" class="dg-note">access and operations</text>
    <rect x="470" y="178" width="150" height="42" rx="6" class="dg-box" /><text x="545" y="203" class="dg-label">SECURITY</text>
    <text x="545" y="240" class="dg-note">data and risk</text>
    <line x1="170" y1="120" x2="260" y2="120" class="dg-line" />
    <line x1="380" y1="112" x2="470" y2="48" class="dg-line" />
    <line x1="380" y1="128" x2="470" y2="192" class="dg-line" />
    <line x1="260" y1="200" x2="380" y2="200" class="dg-line-warn" />
    <text x="320" y="222" class="dg-note dg-note-warn">one meeting for all three</text>
  </svg>
</Figure>
