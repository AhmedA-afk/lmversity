---
import Figure from './Figure.astro';

/**
 * The load-bearing FDE skill, drawn as an order of operations.
 */
---
<Figure
  title="Eval-driven development"
  caption="Label examples with a domain expert, run a small feasibility test, then build, measure and drive adoption. The brass shortcut, building first, leaves you with no way to know whether it works."
  desc="Five boxes in a row: label, feasibility, build, measure, adopt. A dashed brass line enters the build box from above, labelled build first."
>
  <svg viewBox="0 0 660 190" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs><marker id="ef-tip" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 z" class="dg-arrow" /></marker><marker id="ef-tip-warn" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 z" class="dg-arrow-warn" /></marker></defs>
    <rect x="10" y="90" width="110" height="42" rx="6" class="dg-box" /><text x="65" y="115" class="dg-label">LABEL</text>
    <rect x="145" y="90" width="110" height="42" rx="6" class="dg-box" /><text x="200" y="115" class="dg-label">FEASIBILITY</text>
    <rect x="280" y="90" width="110" height="42" rx="6" class="dg-box" /><text x="335" y="115" class="dg-label">BUILD</text>
    <rect x="415" y="90" width="110" height="42" rx="6" class="dg-box" /><text x="470" y="115" class="dg-label">MEASURE</text>
    <rect x="550" y="90" width="100" height="42" rx="6" class="dg-box" /><text x="600" y="115" class="dg-label">ADOPT</text>
    <line x1="120" y1="111" x2="141" y2="111" class="dg-line" marker-end="url(#ef-tip)" />
    <line x1="255" y1="111" x2="276" y2="111" class="dg-line" marker-end="url(#ef-tip)" />
    <line x1="390" y1="111" x2="411" y2="111" class="dg-line" marker-end="url(#ef-tip)" />
    <line x1="525" y1="111" x2="546" y2="111" class="dg-line" marker-end="url(#ef-tip)" />
    <text x="65" y="158" class="dg-note">with a domain expert</text>
    <text x="200" y="158" class="dg-note">a handful of cases</text>
    <path d="M335 30 V86" class="dg-line-warn" marker-end="url(#ef-tip-warn)" />
    <text x="335" y="22" class="dg-note dg-note-warn">build first: nothing to measure against</text>
  </svg>
</Figure>
