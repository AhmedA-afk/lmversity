---
import Figure from './Figure.astro';

/**
 * The origin of the title, drawn as Palantir drew it in 2019.
 */
---
<Figure
  title="Palantir's three roles"
  caption="Devs build one capability for many customers inside Product Development; Deltas deploy many capabilities to one customer and Echoes own the relationship, both inside Business Development. Field work that Deltas did by hand became the product."
  desc="Two containers side by side. Product Development holds one box, Dev. Business Development holds two boxes, Delta and Echo. A line runs from Delta to Dev labelled field work becomes product."
>
  <svg viewBox="0 0 640 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs><marker id="de-tip" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 z" class="dg-arrow" /></marker></defs>
    <rect x="20" y="30" width="220" height="170" rx="6" class="dg-box-mute" />
    <text x="130" y="52" class="dg-note">Product Development</text>
    <rect x="70" y="96" width="120" height="42" rx="6" class="dg-box" />
    <text x="130" y="121" class="dg-label">DEV</text>
    <text x="130" y="162" class="dg-note">one capability,</text>
    <text x="130" y="178" class="dg-note">many customers</text>
    <rect x="300" y="30" width="320" height="170" rx="6" class="dg-box-mute" />
    <text x="460" y="52" class="dg-note">Business Development</text>
    <rect x="330" y="96" width="120" height="42" rx="6" class="dg-box" />
    <text x="390" y="121" class="dg-label">DELTA</text>
    <text x="390" y="162" class="dg-note">one customer,</text>
    <text x="390" y="178" class="dg-note">many capabilities</text>
    <rect x="480" y="96" width="120" height="42" rx="6" class="dg-box" />
    <text x="540" y="121" class="dg-label">ECHO</text>
    <text x="540" y="162" class="dg-note">relationship,</text>
    <text x="540" y="178" class="dg-note">adoption</text>
    <line x1="330" y1="117" x2="194" y2="117" class="dg-line" marker-end="url(#de-tip)" />
    <text x="262" y="108" class="dg-note">field work</text>
    <text x="262" y="134" class="dg-note">becomes product</text>
  </svg>
</Figure>
