---
import Figure from './Figure.astro';

/**
 * The loop as compiled from candidate accounts; the prose carries the sources.
 */
---
<Figure
  title="The Palantir FDSE interview loop"
  caption="Recruiter call, a coding and SQL screen, a virtual onsite of three rounds drawn from a pool, then the hiring manager. Decomposition is brass: it is the round candidates most often fail, by solving before scoping."
  desc="Four stages left to right: recruiter, screen, onsite, hiring manager. The onsite stage is a container holding three boxes: decomposition in brass, learning, and coding or design."
>
  <svg viewBox="0 0 680 210" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs><marker id="il-tip" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 z" class="dg-arrow" /></marker></defs>
    <rect x="10" y="84" width="100" height="42" rx="6" class="dg-box" /><text x="60" y="109" class="dg-label">RECRUITER</text>
    <rect x="130" y="84" width="100" height="42" rx="6" class="dg-box" /><text x="180" y="109" class="dg-label">SCREEN</text>
    <text x="180" y="150" class="dg-note">coding + SQL</text>
    <rect x="250" y="30" width="290" height="150" rx="6" class="dg-box-mute" />
    <text x="395" y="52" class="dg-note">virtual onsite, three rounds</text>
    <rect x="266" y="84" width="82" height="42" rx="6" class="dg-box-warn" /><text x="307" y="103" class="dg-label dg-label-warn">DECOMP-</text><text x="307" y="116" class="dg-label dg-label-warn">OSITION</text>
    <rect x="354" y="84" width="82" height="42" rx="6" class="dg-box" /><text x="395" y="109" class="dg-label">LEARNING</text>
    <rect x="442" y="84" width="82" height="42" rx="6" class="dg-box" /><text x="483" y="103" class="dg-label">CODING /</text><text x="483" y="116" class="dg-label">DESIGN</text>
    <text x="395" y="160" class="dg-note">from a pool of five</text>
    <rect x="560" y="84" width="110" height="42" rx="6" class="dg-box" /><text x="615" y="103" class="dg-label">HIRING</text><text x="615" y="116" class="dg-label">MANAGER</text>
    <line x1="110" y1="105" x2="126" y2="105" class="dg-line" marker-end="url(#il-tip)" />
    <line x1="230" y1="105" x2="246" y2="105" class="dg-line" marker-end="url(#il-tip)" />
    <line x1="540" y1="105" x2="556" y2="105" class="dg-line" marker-end="url(#il-tip)" />
  </svg>
</Figure>
