---
import type { QuizQuestion } from '../data/quizzes';

interface Props {
  questions: QuizQuestion[];
  trackId?: string;
}

const { questions, trackId } = Astro.props;

const quizSchema = {
  '@context': 'https://schema.org',
  '@type': 'Quiz',
  hasPart: questions.map((q, i) => ({
    '@type': 'Question',
    position: i + 1,
    name: q.prompt,
    acceptedAnswer: { '@type': 'Answer', text: q.options[q.answer] ?? '' },
    ...(q.explanation ? { comment: { '@type': 'Comment', text: q.explanation } } : {}),
  })),
};
---
<div class="quiz" data-quiz data-track={trackId ?? ''} data-questions={JSON.stringify(questions)}>
  <div class="quiz-topline">
    <span class="eyebrow">Self-check</span>
    <span class="quiz-count mono" data-count>Question 1 of {questions.length}</span>
  </div>
  <div class="quiz-modes mono" data-modes hidden>
    <button type="button" data-mode-all>All questions</button>
    <button type="button" data-mode-missed>Review missed (<span data-missed-count>0</span>)</button>
    <button type="button" data-shuffle>Shuffle</button>
    <button type="button" data-diff-cycle>Difficulty: all</button>
    <span class="quiz-seed" data-seed-label></span>
  </div>
  <div class="quiz-progress" aria-hidden="true"><span data-progress></span></div>
  <div class="quiz-question" data-question aria-live="polite"></div>
  <div class="quiz-options" data-options></div>
  <div class="quiz-feedback" data-feedback hidden aria-live="polite"></div>
  <div class="quiz-actions">
    <button class="btn btn-primary" type="button" data-next disabled>Choose an answer</button>
  </div>

  {/* Static fallback: the whole quiz, readable without JavaScript and
      extractable by agents. The script removes it when it takes over. */}
  <div class="quiz-static" data-static>
    {questions.map((q, i) => (
      <details class="qs">
        <summary>
          <span class="mono qn">{String(i + 1).padStart(2, '0')}</span> {q.prompt}
        </summary>
        <ol class="qs-opts" type="A">
          {q.options.map((opt, j) => (
            <li class:list={[{ correct: j === q.answer }]}>{opt}</li>
          ))}
        </ol>
        <p class="qs-answer"><strong>Answer: {String.fromCharCode(65 + q.answer)}.</strong> {q.why?.[q.answer] || q.explanation}</p>
        {q.explanation && <p class="qs-takeaway">{q.explanation}</p>}
        {q.lesson && <a class="qs-link" href={q.lesson}>Read the lesson →</a>}
      </details>
    ))}
  </div>
</div>
<script type="application/ld+json" set:html={JSON.stringify(quizSchema)} />

<script>
  const quiz = document.querySelector('[data-quiz]');
  if (quiz instanceof HTMLElement) {
    const trackId = quiz.dataset.track || '';
    const questionEl = quiz.querySelector('[data-question]');
    const optionsEl = quiz.querySelector('[data-options]');
    const feedbackEl = quiz.querySelector('[data-feedback]');
    const nextButton = quiz.querySelector('[data-next]');
    const countEl = quiz.querySelector('[data-count]');
    const progressEl = quiz.querySelector('[data-progress]');
    const modesEl = quiz.querySelector('[data-modes]');
    const missedCountEl = quiz.querySelector('[data-missed-count]');
    const seedLabelEl = quiz.querySelector('[data-seed-label]');

    // --- Seeded sessions: ?seed=N reproduces the same shuffled set ---
    const mulberry32 = (a) => () => {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    const shuffled = (arr, rand) => {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(rand() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };

    const params = new URLSearchParams(location.search);
    const seed = params.get('seed');
    const mode = params.get('mode');

    // --- Missed-question review: wrong answers persist per track, locally ---
    const missedKey = `quiz-missed:${trackId}`;
    const readMissed = () => {
      try { return JSON.parse(localStorage.getItem(missedKey) || '[]'); } catch { return []; }
    };
    const writeMissed = (ids) => {
      try { localStorage.setItem(missedKey, JSON.stringify(ids)); } catch { /* private mode */ }
    };
    const missed = new Set(readMissed());
    if (missedCountEl instanceof HTMLElement) missedCountEl.textContent = String(missed.size);

    let questions = JSON.parse(quiz.dataset.questions || '[]');
    if (seed) {
      questions = shuffled(questions, mulberry32(Number(seed) || 0));
      if (seedLabelEl instanceof HTMLElement) seedLabelEl.textContent = `seed ${seed}`;
    }
    if (mode === 'missed') questions = questions.filter((q) => missed.has(q.id));

    // --- Difficulty filter: ?difficulty=beginner|intermediate|advanced|synthesis ---
    const diff = params.get('difficulty');
    const diffBtn = quiz.querySelector('[data-diff-cycle]');
    if (diff) {
      questions = questions.filter((q) => q.difficulty === diff);
      if (diffBtn instanceof HTMLElement) diffBtn.textContent = `Difficulty: ${diff}`;
    }
    const DIFFS = ['beginner', 'intermediate', 'advanced', 'synthesis'];
    diffBtn?.addEventListener('click', () => {
      const u = new URL(location.href);
      const next = DIFFS[(DIFFS.indexOf(diff ?? '') + 1) % (DIFFS.length + 1)];
      if (next) u.searchParams.set('difficulty', next); else u.searchParams.delete('difficulty');
      location.href = u.toString();
    });

    if (modesEl instanceof HTMLElement) modesEl.hidden = false;
    quiz.querySelector('[data-mode-all]')?.addEventListener('click', () => {
      const u = new URL(location.href); u.searchParams.delete('mode');
      location.href = u.toString();
    });
    quiz.querySelector('[data-mode-missed]')?.addEventListener('click', () => {
      const u = new URL(location.href); u.searchParams.set('mode', 'missed');
      location.href = u.toString();
    });
    quiz.querySelector('[data-shuffle]')?.addEventListener('click', () => {
      const u = new URL(location.href); u.searchParams.set('seed', String(Math.floor(Math.random() * 1e9)));
      u.searchParams.delete('mode');
      location.href = u.toString();
    });

    let current = 0;
    let score = 0;
    let answered = false;

    // JS is running — the interactive flow replaces the static fallback.
    quiz.querySelector('[data-static]')?.remove();

    if (questions.length === 0 && questionEl instanceof HTMLElement) {
      questionEl.textContent = mode === 'missed' ? 'Nothing missed yet — answer a full round first.' : 'No questions here yet.';
      if (countEl instanceof HTMLElement) countEl.textContent = '';
    }

    const showQuestion = () => {
      const item = questions[current];
      if (!item || !(questionEl instanceof HTMLElement) || !(optionsEl instanceof HTMLElement)) return;
      answered = false;
      questionEl.textContent = item.prompt;
      optionsEl.replaceChildren();
      item.options.forEach((option, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'quiz-option';
        button.dataset.index = String(index);
        button.dataset.letter = String.fromCharCode(65 + index);
        button.textContent = option;
        button.addEventListener('click', () => choose(index));
        optionsEl.append(button);
      });
      if (feedbackEl instanceof HTMLElement) { feedbackEl.hidden = true; feedbackEl.replaceChildren(); }
      if (nextButton instanceof HTMLButtonElement) { nextButton.disabled = true; nextButton.textContent = 'Choose an answer'; }
      if (countEl instanceof HTMLElement) countEl.textContent = `Question ${current + 1} of ${questions.length}`;
      if (progressEl instanceof HTMLElement) progressEl.style.width = `${((current + 1) / questions.length) * 100}%`;
    };

    const choose = (index) => {
      if (answered) return;
      const item = questions[current];
      answered = true;
      if (index === item.answer) { score += 1; missed.delete(item.id); } else { missed.add(item.id); }
      writeMissed([...missed]);
      if (missedCountEl instanceof HTMLElement) missedCountEl.textContent = String(missed.size);
      quiz.querySelectorAll('.quiz-option').forEach((node) => {
        if (!(node instanceof HTMLButtonElement)) return;
        const choice = Number(node.dataset.index);
        node.disabled = true;
        if (choice === item.answer) node.classList.add('correct');
        if (choice === index && choice !== item.answer) node.classList.add('incorrect');
      });
      if (feedbackEl instanceof HTMLElement) {
        feedbackEl.replaceChildren();
        const correct = index === item.answer;
        feedbackEl.classList.toggle('is-correct', correct);
        feedbackEl.classList.toggle('is-incorrect', !correct);

        // The specific misconception first — that is the part that teaches.
        const chosen = document.createElement('p');
        const label = document.createElement('strong');
        label.textContent = correct ? 'Correct. ' : 'Not quite. ';
        chosen.append(label, (item.why && item.why[index]) || item.explanation);
        feedbackEl.append(chosen);

        // When they missed it, show what the right answer was doing as well.
        if (!correct && item.why && item.why[item.answer]) {
          const right = document.createElement('p');
          const rightLabel = document.createElement('strong');
          rightLabel.textContent = 'The answer: ';
          right.append(rightLabel, item.why[item.answer].replace(/^Right[.,—-]?\s*/, ''));
          feedbackEl.append(right);
        }

        const takeaway = document.createElement('p');
        takeaway.className = 'takeaway';
        takeaway.textContent = item.explanation;
        feedbackEl.append(takeaway);

        if (item.lesson) {
          const link = document.createElement('a');
          link.className = 'feedback-link';
          link.href = item.lesson;
          link.textContent = 'Read the lesson →';
          feedbackEl.append(link);
        }
        feedbackEl.hidden = false;
      }
      if (nextButton instanceof HTMLButtonElement) {
        nextButton.disabled = false;
        nextButton.textContent = current === questions.length - 1 ? 'See your score' : 'Next question';
      }
    };

    nextButton?.addEventListener('click', () => {
      if (!answered) return;
      if (current === questions.length - 1) {
        if (questionEl instanceof HTMLElement) questionEl.textContent = `You scored ${score} out of ${questions.length}.`;
        if (optionsEl instanceof HTMLElement) optionsEl.replaceChildren();
        if (feedbackEl instanceof HTMLElement) { feedbackEl.hidden = false; feedbackEl.textContent = score === questions.length ? 'Strong work. Revisit any explanations you want to make sharper.' : 'Review the explanations, then try the quiz again to make the mental models stick.'; }
        if (nextButton instanceof HTMLButtonElement) { nextButton.disabled = true; nextButton.textContent = 'Complete'; }
        if (countEl instanceof HTMLElement) countEl.textContent = 'Complete';
        return;
      }
      current += 1;
      showQuestion();
    });

    showQuestion();
  }
</script>

<style is:global>
  .quiz { margin-top: 34px; border: 1px solid var(--rule); background: var(--paper); padding: 24px; border-radius: 8px; }
  .quiz .quiz-topline { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .quiz .quiz-progress { height: 4px; background: var(--rule); margin-top: 18px; border-radius: 999px; overflow: hidden; }
  .quiz .quiz-progress span { display: block; height: 100%; width: 0; background: var(--accent); transition: width .2s ease; }
  .quiz .quiz-question { margin-top: 30px; font: 600 22px/1.3 'Source Serif 4', 'Source Serif 4 Fallback', Georgia, serif; max-width: 34ch; }
  .quiz .quiz-options { display: grid; gap: 8px; margin-top: 24px; }
  .quiz .quiz-option {
    position: relative; border: 1px solid var(--rule); background: var(--bg); color: var(--text);
    padding: 13px 15px 13px 40px; text-align: left; border-radius: 6px;
    font: 400 14px/1.45 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; cursor: pointer;
  }
  /* Option letter, so a result can be described without relying on colour. */
  .quiz .quiz-option::before {
    content: attr(data-letter);
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    font: 500 11px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; color: var(--muted);
  }
  .quiz .quiz-option:hover:not(:disabled) { border-color: var(--accent); background: var(--accent-wash); }
  .quiz .quiz-option:disabled { cursor: default; }
  .quiz .quiz-option.correct {
    border-color: var(--accent); background: var(--accent-wash); color: var(--text); font-weight: 500;
  }
  .quiz .quiz-option.correct::before { content: "✓"; color: var(--accent); font-size: 13px; }
  .quiz .quiz-option.incorrect { border-color: var(--spine-arrow); color: var(--muted); }
  .quiz .quiz-option.incorrect::before { content: "✕"; color: var(--muted); font-size: 12px; }
  .quiz .quiz-option:disabled:not(.correct):not(.incorrect) { color: var(--muted); opacity: .78; }
  .quiz .quiz-feedback { margin-top: 18px; padding: 14px 16px; border-left: 3px solid var(--accent); color: var(--muted); background: var(--bg); font-size: 14px; line-height: 1.6; display: flex; flex-direction: column; gap: 9px; }
  .quiz .quiz-feedback.is-incorrect { border-left-color: var(--spine-arrow); }
  .quiz .quiz-feedback strong { color: var(--text); font-weight: 600; }
  .quiz .quiz-feedback .takeaway { padding-top: 9px; border-top: 1px solid var(--rule); font-size: 13.5px; }
  .quiz .quiz-feedback .feedback-link { font: 500 12.5px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; color: var(--accent); }
  .quiz .quiz-count { font-size: 11px; color: var(--muted); }
  .quiz .quiz-modes { display: flex; gap: 8px; margin-top: 16px; align-items: center; flex-wrap: wrap; }
  .quiz .quiz-modes button {
    font: 500 11px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace;
    border: 1px solid var(--rule); background: var(--bg); color: var(--muted);
    padding: 7px 10px; border-radius: 5px; cursor: pointer;
  }
  .quiz .quiz-modes button:hover { border-color: var(--accent); color: var(--accent); }
  .quiz .quiz-seed { font-size: 10px; color: var(--faint); margin-left: auto; }

  /* Static fallback — visible only until the script takes over. */
  .quiz .quiz-static { margin-top: 24px; border-top: 1px solid var(--rule); }
  .quiz .qs { border-bottom: 1px solid var(--rule); padding: 12px 2px; }
  .quiz .qs summary { cursor: pointer; font: 500 15px/1.45 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; color: var(--text); }
  .quiz .qs .qn { font-size: 11px; color: var(--muted); margin-right: 6px; }
  .quiz .qs-opts { margin: 12px 0 0; padding-left: 22px; display: flex; flex-direction: column; gap: 5px; font-size: 14px; color: var(--muted); }
  .quiz .qs-opts li.correct { color: var(--text); font-weight: 500; }
  .quiz .qs-answer { margin: 12px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--muted); }
  .quiz .qs-answer strong { color: var(--text); }
  .quiz .qs-takeaway { margin: 8px 0 0; padding-top: 8px; border-top: 1px solid var(--rule); font-size: 13px; line-height: 1.6; color: var(--muted); }
  .quiz .qs-link { display: inline-block; margin-top: 8px; font: 500 12.5px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; color: var(--accent); }

  .quiz .quiz-actions { margin-top: 22px; }
  .quiz .quiz-actions .btn:disabled { opacity: .5; cursor: not-allowed; }
  @media (max-width: 540px) { .quiz { padding: 18px; } .quiz-question { font-size: 20px; } }
</style>
